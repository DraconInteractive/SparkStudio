# Copy to .env (which git ignores) and fill in. Used by deploy.ps1.

# SPARK instance to deploy SparkStudio.zip (the zipped exe) to
SPARK_URL=https://spark.dracon.au

# Device token from the SPARK admin (Admin -> Credentials); needs files.read and files.write
SPARK_TOKEN=

# Optional: the device ID the token was issued for (enables a credential/permission check before uploading)
SPARK_DEVICE_ID=

# Optional: where the build goes on the server
SPARK_DEPLOY_DIR=/releases/SparkStudio
# SPARK_DEPLOY_DRIVE=A
# SPARK_DEPLOY_NAME=SparkStudio.zip
