<UserControl x:Class="SparkStudio.Views.BoardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Severity badge; DataContext is the severity string. -->
        <Style x:Key="SeverityPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Background" Value="#F0EEF4"/>
            <Setter Property="TextElement.Foreground" Value="#6B6875"/>
            <Setter Property="TextElement.FontSize" Value="11"/>
            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="Very Low"><Setter Property="Background" Value="#EEF0F3"/><Setter Property="TextElement.Foreground" Value="#5E6773"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Low"><Setter Property="Background" Value="#E3F0FB"/><Setter Property="TextElement.Foreground" Value="#1F6FB2"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Normal"><Setter Property="Background" Value="#F0EEF4"/><Setter Property="TextElement.Foreground" Value="#6B6875"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="High"><Setter Property="Background" Value="#FFF1D6"/><Setter Property="TextElement.Foreground" Value="#9A5B00"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Very High"><Setter Property="Background" Value="#FFE4D4"/><Setter Property="TextElement.Foreground" Value="#B8430A"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Urgent"><Setter Property="Background" Value="#C4314B"/><Setter Property="TextElement.Foreground" Value="#FFFFFF"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Card frame; higher severities get a coloured left edge so they stand out when scanning a column. -->
        <Style x:Key="CardFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource EditorBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="High"><Setter Property="BorderBrush" Value="#E8A33A"/><Setter Property="BorderThickness" Value="3,1,1,1"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Very High"><Setter Property="BorderBrush" Value="#E8590C"/><Setter Property="BorderThickness" Value="3,1,1,1"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Urgent"><Setter Property="BorderBrush" Value="#C4314B"/><Setter Property="BorderThickness" Value="3,1,1,1"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Board toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="Board" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                <ComboBox Width="220" ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}" DisplayMemberPath="Name"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" ToolTip="Rename board" Command="{Binding RenameBoardCommand}" Margin="6,0,0,0"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete board" Command="{Binding DeleteBoardCommand}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}"/>
                <Button Content="+ New board" Style="{StaticResource FlatButton}" Command="{Binding NewBoardCommand}" Margin="8,0,0,0"/>
                <Border Width="1" Background="{StaticResource LineBrush}" Margin="10,4,2,4"/>
                <Button x:Name="SortButton" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="SortButton_Click"
                        ToolTip="Sort cards within each column">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Sort: " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SortLabel}" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Sort by" IsEnabled="False"/>
                            <MenuItem Header="Date created" IsChecked="{Binding IsSortCreated, Mode=OneWay}" Command="{Binding SortByCommand}" CommandParameter="Created"/>
                            <MenuItem Header="Name" IsChecked="{Binding IsSortName, Mode=OneWay}" Command="{Binding SortByCommand}" CommandParameter="Name"/>
                            <MenuItem Header="Severity" IsChecked="{Binding IsSortSeverity, Mode=OneWay}" Command="{Binding SortByCommand}" CommandParameter="Severity"
                                      Visibility="{Binding SupportsSeverity, Converter={StaticResource BoolToVis}}"/>
                            <Separator/>
                            <MenuItem Header="Ascending" IsChecked="{Binding IsSortAscending, Mode=OneWay}" Command="{Binding SortDirectionCommand}" CommandParameter="False"/>
                            <MenuItem Header="Descending" IsChecked="{Binding SortDescending, Mode=OneWay}" Command="{Binding SortDirectionCommand}" CommandParameter="True"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock Text="Drag cards between columns. Double-click a card to edit it." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBoards}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="This project has no boards yet." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <Button Content="Create a board" Style="{StaticResource PrimaryButton}" Command="{Binding NewBoardCommand}" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="12"
                          Visibility="{Binding HasBoards, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="290" Margin="0,0,12,0" CornerRadius="8" Background="{StaticResource ColumnBrush}" Padding="8"
                                        AllowDrop="True" Drop="Column_Drop" DragOver="Column_DragOver" DragLeave="Column_DragLeave">
                                    <DockPanel>
                                        <!-- Column header -->
                                        <DockPanel DockPanel.Dock="Top" Margin="4,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Column options" Click="ColumnMenu_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Rename column…"
                                                                  Command="{Binding PlacementTarget.Tag.RenameColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Delete column…"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Button.Tag>
                                                    <Binding Path="DataContext" ElementName="Root"/>
                                                </Button.Tag>
                                            </Button>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tasks.Count}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0"/>
                                            <TextBlock Text="{Binding Column.Name}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <!-- Add task -->
                                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                            <Button Content="+ Add task" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Foreground="{StaticResource MutedBrush}"
                                                    Command="{Binding DataContext.BeginAddTaskCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBox Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}"
                                                     IsVisibleChanged="AddBox_IsVisibleChanged" LostKeyboardFocus="AddBox_LostFocus"
                                                     ToolTip="Enter to add, Esc to finish">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding DataContext.CommitAddTaskCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                    <KeyBinding Key="Escape" Command="{Binding DataContext.CancelAddTaskCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>

                                        <!-- Cards -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource CardFrame}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" Cursor="Hand"
                                                                MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseMove="Card_MouseMove">
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Edit…" Command="{Binding PlacementTarget.Tag.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                                    <MenuItem Header="Severity" ItemsSource="{Binding SeverityOptions}"
                                                                              Visibility="{Binding PlacementTarget.Tag.SupportsSeverity, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                                                                        <MenuItem.ItemContainerStyle>
                                                                            <Style TargetType="MenuItem">
                                                                                <Setter Property="Header" Value="{Binding Level}"/>
                                                                                <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}"/>
                                                                                <Setter Property="Command" Value="{Binding Card.SetSeverityCommand}"/>
                                                                                <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                            </Style>
                                                                        </MenuItem.ItemContainerStyle>
                                                                    </MenuItem>
                                                                    <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <Border.Tag>
                                                                <Binding Path="DataContext" ElementName="Root"/>
                                                            </Border.Tag>
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <Border DockPanel.Dock="Right" Style="{StaticResource SeverityPill}" DataContext="{Binding Severity}"
                                                                            VerticalAlignment="Top" Margin="8,1,0,0" ToolTip="Severity"
                                                                            Visibility="{Binding DataContext.ShowSeverity, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{Binding}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Task.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Preview}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                           Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+ Add column" Style="{StaticResource FlatButton}" VerticalAlignment="Top" Width="200"
                            Foreground="{StaticResource MutedBrush}" Command="{Binding AddColumnCommand}" Padding="10,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Offline: boards aren't kept on this PC, and editing needs the server. -->
            <Border Background="{StaticResource WindowBrush}" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="&#xF384;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Boards need a connection" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock Text="You're offline. Boards will be back as soon as the server can be reached; notes saved on this PC are still available in the Notes tab."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
